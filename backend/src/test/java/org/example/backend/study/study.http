### 변수 설정
@baseUrl = http://localhost:8081
@contentType = application/json
@boundary = WebAppBoundary

### 로그인 (accessToken 발급 - 아래 요청들에서 사용)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "test@naver.com",
  "password": "test1234"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
%}

### 스터디 개설
POST {{baseUrl}}/api/studies
Content-Type: multipart/form-data; boundary={{boundary}}
Authorization: Bearer {{accessToken}}

--{{boundary}}
Content-Disposition: form-data; name="data"
Content-Type: {{contentType}}

{
  "title": "알고리즘 스터디",
  "description": "매주 백준 3문제씩 풀어요",
  "capacity": 5,
  "recruitEnd": "2026-08-20",
  "category": "IT_DEVELOPMENT"
}
--{{boundary}}

### 스터디 개설 (이미지 포함)
POST {{baseUrl}}/api/studies
Content-Type: multipart/form-data; boundary={{boundary}}
Authorization: Bearer {{accessToken}}

--{{boundary}}
Content-Disposition: form-data; name="data"
Content-Type: {{contentType}}

{
  "title": "알고리즘 스터디 (이미지 첨부)",
  "description": "매주 백준 3문제씩 풀어요",
  "capacity": 5,
  "recruitEnd": "2026-08-20",
  "category": "IT_DEVELOPMENT"
}
--{{boundary}}
Content-Disposition: form-data; name="images"; filename="test-image.jpg"
Content-Type: image/jpeg

< ./test-files/test-image.jpg
--{{boundary}}--

### 스터디 목록 조회 (키워드 검색 X)
GET {{baseUrl}}/api/studies?page=0&size=10

### 스터디 목록 조회 (키워드 검색 O)
GET {{baseUrl}}/api/studies?keyword=알고리즘&page=0&size=10

### 내가 가입된 스터디 목록 조회
GET {{baseUrl}}/api/studies/my?page=0&size=10
Authorization: Bearer {{accessToken}}

### 스터디 상세 조회
GET {{baseUrl}}/api/studies/2
Authorization: Bearer {{accessToken}}

### 스터디 수정
PUT {{baseUrl}}/api/studies/1
Content-Type: {{contentType}}
Authorization: Bearer {{accessToken}}

{
  "title": "알고리즘 스터디 (수정)",
  "description": "매주 백준 5문제씩 풀어요",
  "capacity": 8,
  "recruitStart": "2026-08-10",
  "recruitEnd": "2026-08-25",
  "category": "JOB_PREP"
}

### 1. 구독 테스트 계정 로그인 (구독자 방장 역할)
# @name loginSubscriber
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "sunwo04@naver.com",
  "password": "test1234!"
}

> {%
    client.global.set("subscriberToken", response.body.data.accessToken);
%}

### 2. 구독 신청
POST {{baseUrl}}/api/subscriptions
Content-Type: {{contentType}}
Authorization: Bearer {{subscriberToken}}

### 3. 구독자 계정으로 스터디 개설
POST {{baseUrl}}/api/studies
Content-Type: multipart/form-data; boundary={{boundary}}
Authorization: Bearer {{subscriberToken}}

--{{boundary}}
Content-Disposition: form-data; name="data"
Content-Type: {{contentType}}

{
  "title": "[구독자] 알고리즘 스터디",
  "description": "구독자 상단고정 확인용",
  "capacity": 5,
  "recruitEnd": "2026-09-20",
  "category": "IT_DEVELOPMENT"
}
--{{boundary}}

### 4. 일반 계정 로그인 (일반 방장 역할)
# @name loginNormal
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "test@naver.com",
  "password": "test1234"
}

> {%
    client.global.set("normalToken", response.body.data.accessToken);
%}

### 5. 일반 계정으로 스터디 개설
POST {{baseUrl}}/api/studies
Content-Type: multipart/form-data; boundary={{boundary}}
Authorization: Bearer {{normalToken}}

--{{boundary}}
Content-Disposition: form-data; name="data"
Content-Type: {{contentType}}

{
  "title": "[일반] CS 스터디",
  "description": "구독자 상단고정 확인용",
  "capacity": 5,
  "recruitEnd": "2026-09-20",
  "category": "IT_DEVELOPMENT"
}
--{{boundary}}

### 6. 목록 조회 ("[구독자] 알고리즘 스터디"가 맨 위로)
GET {{baseUrl}}/api/studies?page=0&size=10