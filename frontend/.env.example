# 백엔드 API 서버 주소
# 실제 값은 .env(gitignore 대상)에 복사해서 사용하세요: cp .env.example .env
VITE_API_BASE_URL=http://localhost:8080


# 카카오 로그인 JavaScript 키 (카카오 개발자 콘솔 > 앱 키)
VITE_KAKAO_JS_KEY=

# 카카오 로그인 REST API 키 (인가 코드를 액세스 토큰으로 교환할 때 사용)
VITE_KAKAO_REST_API_KEY=

# 카카오 로그인 콜백 후 리다이렉트될 주소
VITE_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback